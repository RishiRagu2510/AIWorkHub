{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "GridHub",
        "supportEmail": "rc.gamer.2510@gmail.com"
      }
    }
  },
  "hosting": [
    {
      "site": "gridhub-85fe8",
      "public": "gridhub/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
