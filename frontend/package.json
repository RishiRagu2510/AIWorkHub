{
  "name": "gridhub-frontends",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=@gridhub/gridhub",
    "build": "npm run build --workspaces",
    "lint": "oxlint",
    "preview": "npm run preview --workspace=@gridhub/gridhub",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "format": "prettier --write src vite.config.js",
    "dev:employee": "npm run dev:persona",
    "dev:timesheet": "npm run dev:chronos",
    "dev:all": "node scripts/dev-portals.mjs",
    "dev:landing": "npm run dev --workspace=@gridhub/landing",
    "dev:hub": "npm run dev --workspace=@gridhub/hub",
    "dev:gridhub": "npm run dev --workspace=@gridhub/gridhub",
    "dev:persona": "npm run dev --workspace=@gridhub/persona",
    "dev:chronos": "npm run dev --workspace=@gridhub/chronos"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@microsoft/signalr": "^10.0.11",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-table": "^9.2.4",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sass": "^1.104.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "landing",
    "hub",
    "gridhub",
    "persona",
    "chronos"
  ]
}
