{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "CompanyDomain": "yourcompany.com"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "oidc-callback-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/signin-oidc"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "Match": {
          "Path": "/api/audit/{**catch-all}"
        }
      },
      "agent-route": {
        "ClusterId": "aiagent-cluster",
        "Match": {
          "Path": "/api/v1/agent/{**catch-all}"
        }
      },
      "agent-legacy-route": {
        "ClusterId": "aiagent-cluster",
        "Match": {
          "Path": "/api/agent/{**catch-all}"
        }
      },
      "jira-route": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/api/issues/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "projects-route": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-hub-route": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/hubs/notifications/{**catch-all}"
        }
      },
      "preferences-route": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/api/preferences/{**catch-all}"
        }
      },
      "boards": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/api/boards/{**catch-all}"
        }
      },
      "activity": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/api/activity/{**catch-all}"
        }
      },
      "issues-live": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/hubs/issues/{**catch-all}"
        }
      },
      "boards-live": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/hubs/boards/{**catch-all}"
        }
      },
      "invitations": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/invitations/{**catch-all}"
        }
      },
      "worklogs-route": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/api/worklogs/{**catch-all}"
        }
      },
      "timesheets-route": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/api/timesheets/{**catch-all}"
        }
      },
      "tenants-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/tenants/{**catch-all}"
        }
      },
      "sprints-route": {
        "ClusterId": "jira-cluster",
        "Match": {
          "Path": "/api/sprints/{**catch-all}"
        }
      },
      "employee-route": {
        "ClusterId": "persona-cluster",
        "Match": {
          "Path": "/api/employees/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      }
    },
    "Clusters": {
      "aiagent-cluster": {
        "Destinations": {
          "aiagent-api": {
            "Address": "http://localhost:5250/"
          }
        }
      },
      "audit-cluster": {
        "Destinations": {
          "audit-api": {
            "Address": "http://localhost:5067/"
          }
        }
      },
      "jira-cluster": {
        "Destinations": {
          "jira-api": {
            "Address": "http://localhost:5148/"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://localhost:5233/"
          }
        }
      },
      "persona-cluster": {
        "Destinations": {
          "persona-api": {
            "Address": "http://localhost:5234/"
          }
        }
      }
    }
  }
}
